{
  "server": {
    "listen": "127.0.0.1:8090",
    "requestTimeout": "5m",
    "shutdownTimeout": "10s",
    "maxBodyBytes": 10485760,
    "rateLimitRPS": 100,
    "rateLimitBurst": 200
  },
  "health": {"interval": "500ms", "timeout": "250ms"},
  "circuit": {"failureThreshold": 1, "cooldown": "5s"},
  "proxy": {"maxAttempts": 2},
  "workers": [
    {"name": "vllm-gpu0", "url": "http://127.0.0.1:8000"},
    {"name": "vllm-gpu1", "url": "http://127.0.0.1:8001"}
  ]
}
