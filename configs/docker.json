{
  "server": {
    "listen": "0.0.0.0:8090",
    "requestTimeout": "5m",
    "shutdownTimeout": "10s",
    "maxBodyBytes": 10485760,
    "rateLimitRPS": 10,
    "rateLimitBurst": 20
  },
  "health": {"interval": "2s", "timeout": "1s"},
  "circuit": {"failureThreshold": 2, "cooldown": "5s"},
  "proxy": {"maxAttempts": 2},
  "workers": [
    {"name": "mock-one", "url": "http://mock-one:8082"},
    {"name": "mock-two", "url": "http://mock-two:8082"}
  ]
}
